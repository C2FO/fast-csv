{
    "name": "fast-csv",
    "private": true,
    "scripts": {
        "clean": "lerna run clean",
        "build": "lerna run build",
        "lerna:pub": "lerna publish from-git",
        "lerna:version": "lerna version",
        "release": "pnpm run build && pnpm run lerna:version && pnpm run lerna:pub",
        "test": "pnpm run lint && pnpm run jest && pnpm run examples",
        "format": "prettier --write \"**/*.{ts,js,json,md,mdx,css}\" --ignore-path .prettierignore",
        "format:check": "prettier --check \"**/*.{ts,js,json,md,mdx,css}\" --ignore-path .prettierignore",
        "lint": "eslint --max-warnings 0 \"**/*.ts\" \"examples/**/examples/**/*.js\"",
        "lint:fix": "eslint --max-warnings 0 \"**/*.ts\" \"examples/**/examples/**/*.js\" --fix",
        "lint:ts": "eslint --max-warnings 0 \"**/*.ts\"",
        "lint:js": "eslint --max-warnings 0 \"examples/**/examples/**/*.js\"",
        "jest": "jest --runInBand --coverage",
        "examples": "pnpm -r --if-present run all-examples",
        "benchmarks": "pnpm -r --if-present run benchmarks"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:C2FO/fast-csv.git"
    },
    "workspaces": [
        "packages/*",
        "examples/*",
        "documentation"
    ],
    "packageManager": "pnpm@10.34.6",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.34.4"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-angular": "21.2.3",
        "@eslint/js": "^9.39.2",
        "@types/jest": "30.0.0",
        "@types/node": "24.12.3",
        "@typescript-eslint/eslint-plugin": "8.63.0",
        "@typescript-eslint/parser": "8.63.0",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jest": "29.16.6",
        "eslint-plugin-prettier": "5.5.6",
        "eslint-plugin-tsdoc": "0.5.2",
        "globals": "^17.7.0",
        "husky": "9.1.7",
        "jest": "30.4.2",
        "lerna": "9.0.7",
        "prettier": "3.9.9",
        "ts-jest": "29.4.14",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.63.0"
    },
    "pnpm": {
        "overrides": {
            "lerna>js-yaml": "4.3.2",
            "lerna>pacote": "21.5.1",
            "lerna>tar": "7.5.22",
            "nx>axios": "1.20.0",
            "nx>brace-expansion": "5.0.12",
            "nx>smol-toml": "1.9.0",
            "serialize-javascript": "7.0.5",
            "uuid": "11.1.1"
        }
    }
}
